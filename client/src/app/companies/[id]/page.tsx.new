"use client";

import React, { useState } from 'react';
import { useQuery } from '@tanstack/react-query';
import axios from 'axios';
import { useRouter } from 'next/navigation';
import { Company, Interaction } from '@/types';
import { Evaluation } from './types';
import Image from 'next/image';
import { ArrowLeft } from 'lucide-react';
import { ScoreIndicator } from '@/components/ScoreIndicator';
import EmailList from '@/components/EmailList';
import MetricsPanel from '@/components/MetricsPanel';
import InteractionsPanel from '@/components/InteractionsPanel';
import EvaluationsPanel from '@/components/EvaluationsPanel';

interface CompanyDetailPageProps {
  params: {
    id: string;
  };
}

const fetchCompany = async (id: string): Promise<Company> => {
  const { data } = await axios.get(`http://localhost:8088/api/companies/${id}`);
  return data;
};

const CompanyDetailPage: React.FC<CompanyDetailPageProps> = ({ params }) => {
  const router = useRouter();
  const { id } = params;
  
  const { data: company, isLoading, isError, error } = useQuery<Company, Error>({
    queryKey: ['company', id],
    queryFn: () => fetchCompany(id),
  });

  const [activeTab, setActiveTab] = useState<'overview' | 'evaluation' | 'interactions' | 'emails'>('overview');

  const handleBack = () => {
    // Navigate back to the companies list
    // The filter state will be preserved because it's stored in the FilterContext
    router.push('/companies');
  };

  if (isLoading) {
    return (
      <div className="container mx-auto p-4">
        <button 
          onClick={handleBack}
          className="flex items-center text-blue-600 hover:text-blue-800 mb-4"
        >
          <ArrowLeft size={16} className="mr-1" /> Back to Companies
        </button>
        <div className="animate-pulse">
          <div className="h-8 bg-gray-200 rounded w-1/4 mb-4"></div>
          <div className="h-4 bg-gray-200 rounded w-3/4 mb-6"></div>
          <div className="h-64 bg-gray-200 rounded mb-6"></div>
        </div>
      </div>
    );
  }

  if (isError) {
    return (
      <div className="container mx-auto p-4">
        <button 
          onClick={handleBack}
          className="flex items-center text-blue-600 hover:text-blue-800 mb-4"
        >
          <ArrowLeft size={16} className="mr-1" /> Back to Companies
        </button>
        <div className="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded">
          Error loading company: {error?.message || 'Unknown error'}
        </div>
      </div>
    );
  }

  if (!company) {
    return (
      <div className="container mx-auto p-4">
        <button 
          onClick={handleBack}
          className="flex items-center text-blue-600 hover:text-blue-800 mb-4"
        >
          <ArrowLeft size={16} className="mr-1" /> Back to Companies
        </button>
        <div className="bg-yellow-50 border border-yellow-200 text-yellow-700 px-4 py-3 rounded">
          Company not found
        </div>
      </div>
    );
  }

  return (
    <div className="container mx-auto p-4">
      <button 
        onClick={handleBack}
        className="flex items-center text-blue-600 hover:text-blue-800 mb-4"
      >
        <ArrowLeft size={16} className="mr-1" /> Back to Companies
      </button>
      
      <div className="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
        <div className="p-6">
          <div className="flex items-start gap-6">
            {company.logo && (
              <div className="flex-shrink-0">
                <Image 
                  src={company.logo} 
                  alt={`${company.name} logo`} 
                  width={80} 
                  height={80} 
                  className="rounded-full bg-gray-100"
                />
              </div>
            )}
            <div>
              <h1 className="text-2xl font-bold text-gray-900">{company.name}</h1>
              <p className="text-gray-600 mt-1">{company.oneLiner}</p>
              <div className="flex flex-wrap gap-2 mt-3">
                {company.sectors && company.sectors.map((sector, index) => (
                  <span key={index} className="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                    {sector}
                  </span>
                ))}
                <span className="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                  {company.developmentStage}
                </span>
                <span className="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-purple-100 text-purple-800">
                  {company.batch}
                </span>
              </div>
            </div>
          </div>
        </div>
        
        <div className="border-t border-gray-200">
          <nav className="flex">
            <button
              className={`px-4 py-3 text-sm font-medium ${
                activeTab === 'overview' 
                  ? 'text-blue-600 border-b-2 border-blue-600' 
                  : 'text-gray-500 hover:text-gray-700'
              }`}
              onClick={() => setActiveTab('overview')}
            >
              Overview
            </button>
            <button
              className={`px-4 py-3 text-sm font-medium ${
                activeTab === 'evaluation' 
                  ? 'text-blue-600 border-b-2 border-blue-600' 
                  : 'text-gray-500 hover:text-gray-700'
              }`}
              onClick={() => setActiveTab('evaluation')}
            >
              Evaluation
            </button>
            <button
              className={`px-4 py-3 text-sm font-medium ${
                activeTab === 'interactions' 
                  ? 'text-blue-600 border-b-2 border-blue-600' 
                  : 'text-gray-500 hover:text-gray-700'
              }`}
              onClick={() => setActiveTab('interactions')}
            >
              Interactions
            </button>
            <button
              className={`px-4 py-3 text-sm font-medium ${
                activeTab === 'emails' 
                  ? 'text-blue-600 border-b-2 border-blue-600' 
                  : 'text-gray-500 hover:text-gray-700'
              }`}
              onClick={() => setActiveTab('emails')}
            >
              Emails
            </button>
          </nav>
        </div>
        
        <div className="p-6">
          {activeTab === 'overview' && (
            <div>
              <h2 className="text-lg font-medium text-gray-900 mb-3">Company Description</h2>
              <p className="text-gray-700 mb-6">{company.description}</p>
              
              <MetricsPanel companyId={id} />
              
              <div className="grid grid-cols-1 md:grid-cols-2 gap-6 mt-6">
                <div>
                  <h3 className="text-sm font-medium text-gray-500 mb-1">Website</h3>
                  <p className="text-gray-900">
                    <a href={company.website} target="_blank" rel="noopener noreferrer" className="text-blue-600 hover:underline">
                      {company.website}
                    </a>
                  </p>
                </div>
                <div>
                  <h3 className="text-sm font-medium text-gray-500 mb-1">Founded</h3>
                  <p className="text-gray-900">
                    {new Date(company.foundingDate).toLocaleDateString()}
                  </p>
                </div>
                <div>
                  <h3 className="text-sm font-medium text-gray-500 mb-1">Business Model</h3>
                  <p className="text-gray-900">{company.businessModel}</p>
                </div>
                <div>
                  <h3 className="text-sm font-medium text-gray-500 mb-1">Status</h3>
                  <p className="text-gray-900">{company.status}</p>
                </div>
              </div>
            </div>
          )}
          
          {activeTab === 'evaluation' && (
            <div>
              <EvaluationsPanel companyId={id} />
              
              {company.evaluationScores && (
                <div className="space-y-6 mt-8">
                  <h3 className="text-lg font-medium text-gray-900 mb-4">Legacy Evaluation</h3>
                  {[{ 
                    evaluationDate: new Date().toISOString(),
                    evaluator: 'Auto-Generator',
                    ...company.evaluationScores,
                    ...company.evaluationNotes
                  }].map((evaluation: Evaluation, index: number) => (
                    <div key={index} className="bg-gray-50 p-4 rounded-lg">
                      <div className="flex justify-between items-start mb-4">
                        <div>
                          <h3 className="font-medium text-gray-900">Evaluation from {new Date(evaluation.evaluationDate).toLocaleDateString()}</h3>
                          <p className="text-sm text-gray-500">By {evaluation.evaluator || 'Anonymous'}</p>
                        </div>
                      </div>
                      
                      <div className="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
                        <div className="bg-white p-3 rounded shadow-sm">
                          <h4 className="text-sm font-medium text-gray-500 mb-1">Problem</h4>
                          <div className="flex items-center">
                            <span className="text-xl font-bold text-gray-900 mr-2">{evaluation.problemScore}/10</span>
                          </div>
                          <p className="text-sm text-gray-700 mt-2">{evaluation.problemNotes}</p>
                        </div>
                        
                        <div className="bg-white p-3 rounded shadow-sm">
                          <h4 className="text-sm font-medium text-gray-500 mb-1">Solution</h4>
                          <div className="flex items-center">
                            <span className="text-xl font-bold text-gray-900 mr-2">{evaluation.solutionScore}/10</span>
                          </div>
                          <p className="text-sm text-gray-700 mt-2">{evaluation.solutionNotes}</p>
                        </div>
                        
                        <div className="bg-white p-3 rounded shadow-sm">
                          <h4 className="text-sm font-medium text-gray-500 mb-1">Team</h4>
                          <div className="flex items-center">
                            <span className="text-xl font-bold text-gray-900 mr-2">{evaluation.teamScore}/10</span>
                          </div>
                          <p className="text-sm text-gray-700 mt-2">{evaluation.teamNotes}</p>
                        </div>
                      </div>
                      
                      <div className="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
                        <div className="bg-white p-3 rounded shadow-sm">
                          <h4 className="text-sm font-medium text-gray-500 mb-1">Market</h4>
                          <div className="flex items-center">
                            <span className="text-xl font-bold text-gray-900 mr-2">{evaluation.marketScore}/10</span>
                          </div>
                          <p className="text-sm text-gray-700 mt-2">{evaluation.marketNotes}</p>
                        </div>
                        
                        <div className="bg-white p-3 rounded shadow-sm">
                          <h4 className="text-sm font-medium text-gray-500 mb-1">Business Model</h4>
                          <div className="flex items-center">
                            <span className="text-xl font-bold text-gray-900 mr-2">{evaluation.businessModelScore}/10</span>
                          </div>
                          <p className="text-sm text-gray-700 mt-2">{evaluation.businessModelNotes}</p>
                        </div>
                        
                        <div className="bg-white p-3 rounded shadow-sm">
                          <h4 className="text-sm font-medium text-gray-500 mb-1">Traction</h4>
                          <div className="flex items-center">
                            <span className="text-xl font-bold text-gray-900 mr-2">{evaluation.tractionScore}/10</span>
                          </div>
                          <p className="text-sm text-gray-700 mt-2">{evaluation.tractionNotes}</p>
                        </div>
                      </div>
                      
                      <div className="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
                        <div className="bg-white p-3 rounded shadow-sm">
                          <h4 className="text-sm font-medium text-gray-500 mb-1">Competition</h4>
                          <div className="flex items-center">
                            <span className="text-xl font-bold text-gray-900 mr-2">{evaluation.competitionScore}/10</span>
                          </div>
                          <p className="text-sm text-gray-700 mt-2">{evaluation.competitionNotes}</p>
                        </div>
                        
                        <div className="bg-white p-3 rounded shadow-sm">
                          <h4 className="text-sm font-medium text-gray-500 mb-1">Differentiation</h4>
                          <div className="flex items-center">
                            <span className="text-xl font-bold text-gray-900 mr-2">{evaluation.differentiationScore}/10</span>
                          </div>
                          <p className="text-sm text-gray-700 mt-2">{evaluation.differentiationNotes}</p>
                        </div>
                        
                        <div className="bg-white p-3 rounded shadow-sm">
                          <h4 className="text-sm font-medium text-gray-500 mb-1">Investment Potential</h4>
                          <div className="flex items-center">
                            <span className="text-xl font-bold text-gray-900 mr-2">{evaluation.investmentPotentialScore}/10</span>
                          </div>
                          <p className="text-sm text-gray-700 mt-2">{evaluation.investmentPotentialNotes}</p>
                        </div>
                      </div>
                      
                      {evaluation.overallNotes && (
                        <div className="bg-white p-3 rounded shadow-sm">
                          <h4 className="text-sm font-medium text-gray-500 mb-1">Overall Notes</h4>
                          <p className="text-sm text-gray-700">{evaluation.overallNotes}</p>
                        </div>
                      )}
                    </div>
                  ))}
                </div>
              )}
            </div>
          )}
          
          {activeTab === 'interactions' && (
            <div>
              <InteractionsPanel companyId={id} />
            </div>
          )}
          
          {activeTab === 'emails' && (
            <div>
              <h2 className="text-lg font-medium text-gray-900 mb-4">Company Emails</h2>
              <div className="grid grid-cols-1 gap-6">
                <div>
                  <EmailList companyId={id} />
                </div>
              </div>
            </div>
          )}
        </div>
      </div>
    </div>
  );
};

export default CompanyDetailPage;
